{
  "name": "@berndamend/ts-units",
  "version": "3.2.3",
  "description": "Type-safe physical units for TypeScript, usable with Node.js, Bun and Deno.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/mod.js",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js",
      "default": "./dist/mod.js"
    }
  },
  "imports": {
    "#mod": "./mod.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:exponent": "node generate_exponent.ts > exponent.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@typescript/native": "npm:typescript@^7.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "units",
    "unit",
    "measurement",
    "physical-units",
    "quantity",
    "dimensional-analysis",
    "typescript",
    "type-safe",
    "si-units",
    "nodejs",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BerndAmend/ts-units.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/BerndAmend/ts-units#readme",
  "bugs": {
    "url": "https://github.com/BerndAmend/ts-units/issues"
  }
}
